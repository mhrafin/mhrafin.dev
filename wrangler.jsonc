{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "mhrafin-dev",
	"compatibility_date": "2026-08-16", // Update to the day you deploy
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
	},
	"observability": {
		"enabled": true,
	},
	"routes": [
		{
			"pattern": "mhrafin.dev",
			"zone_name": "mhrafin.dev",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
		},
	],
	"vars": {
		"FROM_EMAIL": "rafin@contact.mhrafin.dev",
		"TO_EMAIL": "subject.raf@gmail.com",
	},
	"workers_dev": false,
	"preview_urls": false,
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "6cbea1e87b474ccb91bec7b40c30f47d",
		},
	],
}