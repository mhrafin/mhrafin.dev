{
  "main": "dist/_worker.js/index.js",
  "name": "mhrafin-dev",
  "compatibility_date": "2026-08-16", // Update to the day you deploy
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
