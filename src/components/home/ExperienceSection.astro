---
import ExperienceEntry from "./ExperienceEntry.astro";
import { getCollection } from "astro:content";

const experiences = (await getCollection("experiences")).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<section id="home-experience-section">
  <div class="flex flex-col items-center justify-center min-h-screen">
    <div class="text-center m-20">
      <h2 class="">Experience</h2>
      <p class="text-4xl max-w-6xl">
        "The competent programmer is fully aware of the strictly limited size of
        his own skull."
      </p>
      <span class="text-text-weak italic">- Dijkstra</span>
    </div>

    <div class="flex flex-col items-center my-10">
      {
        experiences.map((experience, index) => (
          <ExperienceEntry
            experience={experience}
            index={index}
            isFirst={index === 0}
            isLast={index === experiences.length - 1}
          />
        ))
      }
    </div>
  </div>
</section>
