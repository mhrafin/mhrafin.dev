---
import { Image } from "astro:assets";
import GetInTouch from "../../images/get_in_touch.svg";
import { ArrowDownRight, ArrowUpRight } from "@lucide/astro";
import { Icon } from "astro-icon/components";
---

<section id="home-contact-section">
  <div
    class="flex flex-col gap-25 min-h-screen mx-60 my-30 p-30 bg-raised-background rounded-xs"
  >
    <div class="grid grid-cols-3">
      <h2 class="col-span-2 text-9xl font-display font-black">
        Let's Have <br />a Chat!
      </h2>
      <div class="flex items-center justify-center">
        <ArrowDownRight
          class="absolute text-fill-background"
          size={52}
          stroke-width="0.5"
        />
        <Image src={GetInTouch} alt="Get in touch" />
      </div>
    </div>
    <p>
      Let me help you become even greater at what you do. <br /> Fill out the following
      form and I will get back to you in the next 24 hours.
    </p>
    <div class="grid grid-cols-3">
      <form action="" method="POST" class="col-span-2 flex flex-col gap-10">
        <div class="grid grid-cols-[auto_1fr] gap-10 max-w-150">
          <div class="flex items-start">
            <div class="flex-none rounded-full bg-overlay-background px-3 py-1">
              01
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label>What's your name?</label>
            <input
              type="text"
              name="name"
              required
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3"
              autocomplete="name"
            />
          </div>
        </div>
        <div class="grid grid-cols-[auto_1fr] gap-10 max-w-150">
          <div class="flex items-start">
            <div class="flex-none rounded-full bg-overlay-background px-3 py-1">
              02
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label>What's your email address?</label>
            <input
              type="email"
              name="email"
              required
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3"
              autocomplete="email"
            />
          </div>
        </div>
        <div class="grid grid-cols-[auto_1fr] gap-10 max-w-150">
          <div class="flex items-start">
            <div class="flex-none rounded-full bg-overlay-background px-3 py-1">
              03
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label>What's your message?</label>
            <input
              type="text"
              name="message"
              required
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3"
              autocomplete="message"
            />
          </div>
        </div>
        <button
          class="border-2 border-stroke-strong rounded-full w-fit px-5 py-3 mx-2 flex hover:bg-brand hover:text-fill-background hover:border-transparent"
          >SEND MESSAGE
          <ArrowUpRight class="ml-2" size={24} stroke-width="1.5" />
        </button>
      </form>
      <div class="flex flex-col items-center text-start w-full">
        <div class="flex flex-col gap-2">
          <h2 class="text-text-weak mb-6">REACH ME</h2>
          <a
            href="https://www.linkedin.com/in/mhrafin/"
            class="flex w-full gap-2"
          >
            <Icon name="mdi:linkedin" width="24" height="24" />
            <p class="">in/mhrafin/</p>
          </a>
          <a href="mailto:mhrafin.code@gmail.com" class="flex w-full gap-2">
            <Icon name="mdi:email" width="24" height="24" />
            <p class="">mhrafin.code@gmail.com</p>
          </a>
          <a href="https://t.me/mhrafin_dev" class="flex w-full gap-2">
            <Icon name="mingcute:telegram-fill" width="24" height="24" />
            <p class="">@mhrafin_dev</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
