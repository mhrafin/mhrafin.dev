---
import { Image } from "astro:assets";
import GetInTouch from "../../images/get_in_touch.svg";
import {
  ArrowDownRight,
  ArrowUpRight,
  AtSign,
  Mail,
  Send,
} from "@lucide/astro";
---

<section id="home-contact-section">
  <div
    class="flex flex-col gap-6 mx-4 my-6 p-5 bg-raised-background rounded-xs sm:mx-8 sm:my-10 sm:p-8 md:mx-12 md:p-12 xl:mx-60 xl:mb-30 xl:gap-25 xl:p-15 2xl:p-30"
  >
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1.5fr)_auto] xl:grid-cols-3"
    >
      <h2
        class="text-5xl sm:text-6xl md:text-7xl xl:col-span-2 xl:text-8xl 2xl:text-9xl font-display font-black"
      >
        Let's Have <br />a Chat!
      </h2>
      <div class="flex items-center justify-center">
        <ArrowDownRight
          class="absolute text-fill-background"
          size={52}
          stroke-width="0.5"
        />
        <Image
          src={GetInTouch}
          alt="Get in touch"
          class="w-32 sm:w-40 md:w-48 xl:w-auto"
        />
      </div>
    </div>
    <p class="max-w-2xl text-sm sm:text-base">
      Let me help you become even greater at what you do. <br
        class="hidden sm:block"
      /> Fill out the following form and I will get back to you in the next 24 hours.
    </p>
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-3">
      <form
        id="contact-form"
        method="POST"
        class="flex flex-col gap-4 sm:gap-6 xl:col-span-2 xl:gap-10"
      >
        <div
          class="grid grid-cols-[auto_1fr] gap-3 sm:gap-4 xl:gap-10 max-w-150"
        >
          <div class="flex items-start">
            <div
              class="flex-none rounded-full bg-overlay-background px-3 py-1 text-sm"
            >
              01
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label class="text-sm sm:text-base">What's your name?</label>
            <input
              type="text"
              name="name"
              required
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3"
              autocomplete="name"
            />
            <p id="name-error" class="text-red-400 text-sm"></p>
          </div>
        </div>
        <div
          class="grid grid-cols-[auto_1fr] gap-3 sm:gap-4 xl:gap-10 max-w-150"
        >
          <div class="flex items-start">
            <div
              class="flex-none rounded-full bg-overlay-background px-3 py-1 text-sm"
            >
              02
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label class="text-sm sm:text-base"
              >What's your email address?</label
            >
            <input
              type="email"
              name="email"
              required
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3"
              autocomplete="email"
            />
            <p id="email-error" class="text-red-400 text-sm"></p>
          </div>
        </div>
        <div
          class="grid grid-cols-[auto_1fr] gap-3 sm:gap-4 xl:gap-10 max-w-150"
        >
          <div class="flex items-start">
            <div
              class="flex-none rounded-full bg-overlay-background px-3 py-1 text-sm"
            >
              03
            </div>
          </div>
          <div class="flex flex-col py-1">
            <label class="text-sm sm:text-base">What's your message?</label>
            <textarea
              name="message"
              required
              rows={4}
              class="w-full bg-transparent border-0 border-b-2 border-stroke-weak
         focus:border-stroke-strong outline-none transition-colors py-3 resize-none"
            ></textarea>
            <p id="message-error" class="text-red-400 text-sm"></p>
          </div>
        </div>
        <p id="form-error" class="text-red-400 text-sm"></p>
        <button
          id="submit-button"
          type="submit"
          class="border-2 border-stroke-strong rounded-full w-full sm:w-fit px-5 py-3 sm:mx-2 flex items-center justify-center hover:bg-brand hover:text-fill-background hover:border-transparent disabled:opacity-50 disabled:pointer-events-none"
          ><span id="submit-label">SEND MESSAGE</span>
          <ArrowUpRight class="ml-2" size={24} stroke-width="1.5" />
        </button>
      </form>
      <div
        class="flex flex-col items-start xl:items-center text-start w-full ml-7 xl:ml-0 text-sm xl:text-base"
      >
        <div class="flex flex-col gap-2">
          <h2 class="text-text-weak mb-1 xl:mb-6">REACH ME</h2>
          <a
            href="https://www.linkedin.com/in/mhrafin/"
            class="flex w-full gap-2"
          >
            <AtSign size={24} />
            <p class="">in/mhrafin/</p>
          </a>
          <a href="mailto:mhrafin.code@gmail.com" class="flex w-full gap-2">
            <Mail size={24} />
            <p class="">mhrafin.code@gmail.com</p>
          </a>
          <a href="https://t.me/mhrafin_dev" class="flex w-full gap-2">
            <Send size={24} />
            <p class="">@mhrafin_dev</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions, isInputError } from "astro:actions";

  const form = document.querySelector("#contact-form");
  const nameError = document.querySelector("#name-error");
  const emailError = document.querySelector("#email-error");
  const messageError = document.querySelector("#message-error");
  const formError = document.querySelector("#form-error");
  const submitButton = document.querySelector("#submit-button");
  const submitLabel = document.querySelector("#submit-label");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    submitButton.disabled = true;
    const originalLabel = submitLabel.textContent;
    submitLabel.textContent = "SENDING…";

    try {
      const { error } = await actions.submitMessage(new FormData(form));

      if (isInputError(error)) {
        for (const issue of error.issues) {
          if (issue.path[0] === "name") nameError.textContent = issue.message;
          if (issue.path[0] === "email") emailError.textContent = issue.message;

          if (issue.path[0] === "message")
            messageError.textContent = issue.message;
        }
        return;
      }

      if (error) {
        formError.textContent = error.message;
        return;
      }

      const card = document.querySelector("#home-contact-section > div");
      card.innerHTML = `
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
      <div class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-display font-black">
        Thank you for contacting me!
      </div>
      <div class="flex flex-col mt-0 gap-4 md:mt-6 md:gap-5">
        <p class="text-2xl sm:text-3xl md:text-4xl">I have received your message.</p>
        <p class="text-sm sm:text-base">
          Your message has been received and I will be contacting you shortly to
          follow-up.
        </p>
      </div>
    </div>
      `;
    } catch (err) {
      console.error("Failed to submit contact form", err);
      formError.textContent =
        err instanceof Error && err.message
          ? err.message
          : "Something went wrong. Please try again.";
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = originalLabel;
    }
  });
</script>
